<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp" android:layout_margin="6dp">
    <TextView android:id="@+id/avatarTv" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_green_round" android:gravity="center" android:text="U" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/nameTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Name" android:textColor="@color/zop_text" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/lastTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Last message" android:textColor="@color/zop_muted" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/timeTv" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/zop_muted" android:textSize="12sp" />
</LinearLayout>
