<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="80dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_green_round" android:gravity="center" android:text="Z" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Zop Chat" android:textColor="@color/zop_text" android:textSize="24sp" android:textStyle="bold" />
        <Button android:id="@+id/logoutBtn" android:layout_width="wrap_content" android:layout_height="44dp" android:backgroundTint="#E9F7F2" android:text="Logout" android:textAllCaps="false" android:textColor="@color/zop_green" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp">
        <EditText android:id="@+id/searchMobileEt" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Search mobile number" android:inputType="phone" android:singleLine="true" />
        <Button android:id="@+id/searchBtn" android:layout_width="92dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:backgroundTint="@color/zop_green" android:text="Chat" android:textAllCaps="false" android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="18dp" android:text="Recent chats" android:textColor="@color/zop_text" android:textSize="18sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatRecycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="10dp" />
</LinearLayout>
